rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isBusinessOwner() {
      return isAuthenticated() && 
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.roles.hasAny(['business_owner']);
    }
    
    function isSameBusinessEntity(userId) {
      return userId == request.auth.uid || 
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.vendorId == 
        firestore.get(/databases/(default)/documents/users/$(userId)).data.vendorId;
    }

    // Media files
    match /media/{userId}/{fileName} {
      allow read: if true; // Public read access
      allow write: if isBusinessOwner() && (request.auth.uid == userId || 
        (isAuthenticated() && isSameBusinessEntity(userId)));
      allow delete: if isBusinessOwner() && (request.auth.uid == userId || 
        (isAuthenticated() && isSameBusinessEntity(userId)));
    }

    // Profile images
    match /profiles/{userId}/{fileName} {
      allow read: if true; // Public read access
      allow write: if isAuthenticated() && (request.auth.uid == userId || 
        (isBusinessOwner() && isSameBusinessEntity(userId)));
      allow delete: if isAuthenticated() && (request.auth.uid == userId || 
        (isBusinessOwner() && isSameBusinessEntity(userId)));
    }
    
    // Business-specific files (products, inventory images, etc.)
    match /business/{businessId}/{fileName} {
      allow read: if true; // Public read access
      allow write: if isBusinessOwner() && 
        (businessId == firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.businessId);
      allow delete: if isBusinessOwner() && 
        (businessId == firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.businessId);
    }

    // ⚠️ SECURITY: Message attachments (images, videos, documents)
    // All uploads MUST go through backend API - direct frontend uploads are BLOCKED
    match /messages/{conversationId}/attachments/{allPaths=**} {
      // Block ALL direct writes from frontend (uploads only via backend)
      allow write: if false;
      
      // Allow authenticated users to read
      allow read: if isAuthenticated();
    }
  }
} 