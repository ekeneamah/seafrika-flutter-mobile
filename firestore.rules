rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isVendor() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['vendor']);
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() &&
        resource.data.vendorId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.vendorId;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if false; // Prevent user deletion
    }

    // Products collection
    match /products/{productId} {
      allow read: if true; // Public read access
      allow create: if isVendor() && request.resource.data.vendorId == request.auth.uid;
      allow update: if isVendor() && resource.data.vendorId == request.auth.uid;
      allow delete: if isVendor() && resource.data.vendorId == request.auth.uid;
    }

    // Media collection
    match /media/{mediaId} {
      allow read: if true; // Public read access
      allow create: if isVendor() && request.resource.data.vendorId == request.auth.uid;
      allow update: if isVendor() && resource.data.vendorId == request.auth.uid;
      allow delete: if isVendor() && resource.data.vendorId == request.auth.uid;
    }

    // Roles collection
    match /roles/{roleId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isVendor();
    }

    // Permissions collection
    match /permissions/{permissionId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isVendor();
    }

    // Store-specific roles for users
    match /users/{userId}/storeRoles/{storeId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isOwner(userId);
    }
  }
}