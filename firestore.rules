rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Global rule - allow all operations for authenticated users
    match /{document=**} {
      // Allow read, write operations for any authenticated user
      allow read, write: if isAuthenticated();
    }
  }
}